/* ========================================
   Hero Section
   ======================================== */






.hero-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-visual {
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.about-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.map-placeholder {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--card);
}

.google-map {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

/* ========================================
   Services Section
   ======================================== */
.services {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.services-header {
  text-align: center;
}

.header-line {
  width: 60px;
  height: 1px;
  background: var(--accent);
  margin: var(--space-2) auto var(--space-6);
}

.services-intro {
  max-width: 640px;
  text-align: center;
  margin-bottom: var(--space-8);
}

.services-intro h3 {
  margin-bottom: var(--space-3);
}

.services-intro p {
  margin: 0 auto;
}

/* Dry cleaning item grid: image + label cards */
.dry-cleaning-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-4);
  width: 100%;
  margin-bottom: var(--space-8);
}

.dry-cleaning-card {
  background: var(--card);
  border: 1px solid var(--border);
}

.dry-cleaning-card-image {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.dry-cleaning-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.dry-cleaning-card-label {
  padding: var(--space-3) var(--space-4);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
}

/* Everyday-garments chip list, shown beneath the specialty grid */
.service-chips-block {
  width: 100%;
  text-align: center;
  margin-bottom: var(--space-10);
}

.service-items {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2);
}

.service-item {
  padding: var(--space-2) var(--space-4);
  background: var(--card);
  border: 1px solid var(--border);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--primary);
}

.services-note {
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted-foreground);
  margin-bottom: var(--space-12);
}

/* Alterations / Pressing cards */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
  width: 100%;
  max-width: 800px;
}

.service-card {
  border: 1px solid var(--border);
  background: var(--card);
  text-align: left;
}

.service-card-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.service-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.service-card-content {
  padding: var(--space-6) var(--space-6) var(--space-8);
}

.service-card-content h4 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 500;
  margin: 0 0 var(--space-3);
  color: var(--primary);
}

.service-card-content p {
  margin: 0 0 var(--space-4);
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.service-card-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.service-card-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.8125rem;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
  line-height: 1.5;
}

.service-card-list li::before {
  content: '•';
  color: var(--accent);
  flex-shrink: 0;
}

/* ========================================
   Reviews Section
   ======================================== */

.reviews {
  width: 100%;
  background: var(--foreground);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.reviews-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-10);
}

.reviews-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 0.875rem;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
}

.reviews-stars {
  color: var(--accent);
  font-size: 1rem;
  letter-spacing: 2px;
}

.reviews-rating strong {
  color: var(--primary);
}

.reviews-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--space-6);
  max-width: 1200px;
  margin: 0 auto;
}

.review-card {
  background: var(--background);
  border: 1px solid var(--border);
  padding: var(--space-6);
  text-align: left;
}

.review-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.review-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--primary);
  color: var(--primary-foreground);
  font-family: var(--font-serif);
  font-size: 1rem;
}

.review-name {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--primary);
}

.review-location {
  font-size: 0.75rem;
  color: var(--muted-foreground);
}

.review-stars {
  color: var(--accent);
  font-size: 0.875rem;
  letter-spacing: 2px;
  margin-bottom: var(--space-3);
}

.review-quote {
  font-style: italic;
  font-size: 0.875rem;
  line-height: 1.7;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
  margin: 0;
}

/* ========================================
   About Section
   ======================================== */

.about {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-12);
  align-items: center;
}

.about-content {
  text-align: left;
}

.about p {
  margin: 16px 0 0;
  max-width: 560px;
}

.about p:first-of-type {
  margin-top: var(--space-6);
}

/* ========================================
   Contact Section
   ======================================== */

.contact {
  text-align: center;
}

.contact-layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-10);
  margin-top: var(--space-10);
  align-items: start;
  text-align: left;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.contact-info {
  display: grid;
  gap: var(--space-6);
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.info-header svg {
  flex-shrink: 0;
  color: var(--primary);
  width: 20px;
  height: 20px;
}

.info-item strong {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--primary);
  margin: 0;
}

.info-item p {
  margin: 0;
  font-size: 0.95rem;
}

/* Compact hours table used in contact section */
.hours-table {
  border-collapse: collapse;
  margin-top: 0.5rem;
  font-size: 0.95rem;
}
.hours-table td {
  padding: 2px 6px;
  vertical-align: top;
}
.hours-table td:first-child {
  width: 3.2rem;
  font-weight: 600;
  color: var(--primary);
  padding-right: 8px;
}
.open-now {
  color: var(--accent);
  font-weight: 700;
  margin-left: 6px;
}

.phone-link {
  color: var(--primary);
  font-weight: 600;
}

.phone-link:hover {
  color: var(--accent-hover);
}

.contact-note {
  margin: var(--space-6) 0 !important;
  font-size: 0.9rem;
}

.contact .btn {
  margin-top: var(--space-2);
}