/* ========================================
   Services Section
   ======================================== */
.services {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.services-header {
  text-align: center;
}

.header-line {
  width: 60px;
  height: 1px;
  background: var(--accent);
  margin: var(--space-2) auto var(--space-6);
}

.services-intro {
  max-width: 640px;
  text-align: center;
  margin-bottom: var(--space-8);
}

.services-intro h3 {
  margin-bottom: var(--space-3);
}

.services-intro p {
  margin: 0 auto;
}

/* Dry cleaning item grid: image + label cards */
.dry-cleaning-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-4);
  width: 100%;
  margin-bottom: var(--space-8);
}

.dry-cleaning-card {
  background: var(--card);
  border: 1px solid var(--border);
}

.dry-cleaning-card-image {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.dry-cleaning-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.dry-cleaning-card-label {
  padding: var(--space-3) var(--space-4);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
}

/* Everyday-garments chip list, shown beneath the specialty grid */
.service-chips-block {
  width: 100%;
  text-align: center;
  margin-bottom: var(--space-10);
}

.service-items {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2);
}

.service-item {
  padding: var(--space-2) var(--space-4);
  background: var(--card);
  border: 1px solid var(--border);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--primary);
}

.services-note {
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted-foreground);
  margin-bottom: var(--space-12);
}

/* Alterations / Pressing cards */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
  width: 100%;
  max-width: 800px;
}

.service-card {
  border: 1px solid var(--border);
  background: var(--card);
  text-align: left;
}

.service-card-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.service-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.service-card-content {
  padding: var(--space-6) var(--space-6) var(--space-8);
}

.service-card-content h4 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 500;
  margin: 0 0 var(--space-3);
  color: var(--primary);
}

.service-card-content p {
  margin: 0 0 var(--space-4);
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.service-card-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.service-card-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.8125rem;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
  line-height: 1.5;
}

.service-card-list li::before {
  content: '•';
  color: var(--accent);
  flex-shrink: 0;
}

/* ========================================
   Reviews Section
   ======================================== */

.reviews {
  width: 100%;
  background: var(--foreground);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.reviews-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-10);
}

.reviews-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 0.875rem;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
}

.reviews-stars {
  color: var(--accent);
  font-size: 1rem;
  letter-spacing: 2px;
}

.reviews-rating strong {
  color: var(--primary);
}

.reviews-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--space-6);
  max-width: 1200px;
  margin: 0 auto;
}

.review-card {
  background: var(--background);
  border: 1px solid var(--border);
  padding: var(--space-6);
  text-align: left;
}

.review-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.review-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--primary);
  color: var(--primary-foreground);
  font-family: var(--font-serif);
  font-size: 1rem;
}

.review-name {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--primary);
}

.review-location {
  font-size: 0.75rem;
  color: var(--muted-foreground);
}

.review-stars {
  color: var(--accent);
  font-size: 0.875rem;
  letter-spacing: 2px;
  margin-bottom: var(--space-3);
}

.review-quote {
  font-style: italic;
  font-size: 0.875rem;
  line-height: 1.7;
  color: color-mix(in srgb, var(--primary) 75%, var(--muted) 25%);
  margin: 0;
}





