const GiftCardsSection = () => {
  // Gift card request form — client-side only, no backend wired up yet.
  // Wire submitGiftCard to a real email/order endpoint before launch.
  const [giftTier, setGiftTier] = useState(50)
  const [customAmount, setCustomAmount] = useState('')
  const [recipientName, setRecipientName] = useState('')
  const [recipientEmail, setRecipientEmail] = useState('')
  const [giftMessage, setGiftMessage] = useState('')
  const [giftSubmitted, setGiftSubmitted] = useState(false)

  const giftAmount = customAmount ? parseInt(customAmount, 10) || 0 : giftTier || 0
  const giftAmountDisplay = giftAmount > 0 ? `$${giftAmount}` : '$0'
  const giftSubmitDisabled = !(giftAmount > 0 && recipientEmail)

  const selectGiftTier = (value) => {
    setGiftTier(value)
    setCustomAmount('')
  }

  const handleCustomAmount = (e) => {
    setCustomAmount(e.target.value.replace(/[^0-9]/g, ''))
    setGiftTier(null)
  }

  const submitGiftCard = (e) => {
    e.preventDefault()
    if (giftAmount > 0 && recipientEmail) setGiftSubmitted(true)
  }

  const resetGiftCard = () => {
    setGiftTier(50)
    setCustomAmount('')
    setRecipientName('')
    setRecipientEmail('')
    setGiftMessage('')
    setGiftSubmitted(false)
  }
  return (
        <section className="gift-cards" id="gift-cards">
          <div className="gift-cards-layout">
            <div className="gift-cards-info">
              <p className="section-label">GIFT CARDS</p>
              <h2>Give the gift of great care</h2>
              <p>A K&amp;B gift card covers dry cleaning, alterations, or pressing — perfect for a new home, a new job, or someone who deserves sharper clothes. Delivered by email, redeemable in-store.</p>

              <div className="gift-card-visual">
                <div className="gift-card-brand">K&amp;B</div>
                <div className="gift-card-label">Gift Card</div>
                <div className="gift-card-sub">Dry Cleaners &amp; Alterations</div>
                <div className="gift-card-amount">{giftAmountDisplay}</div>
              </div>
            </div>

            <div className="gift-cards-form">
              {giftSubmitted ? (
                <div className="gift-cards-success">
                  <div className="gift-cards-success-icon" aria-hidden="true">✓</div>
                  <h4>Request received</h4>
                  <p>We&apos;ll follow up at {recipientEmail} to complete your {giftAmountDisplay} gift card order.</p>
                  <a href="#gift-cards" className="gift-cards-restart" onClick={(e) => { e.preventDefault(); resetGiftCard() }}>
                    START OVER
                  </a>
                </div>
              ) : (
                <form onSubmit={submitGiftCard}>
                  <div className="gift-cards-form-label">CHOOSE AN AMOUNT</div>
                  <div className="gift-tier-grid">
                    {giftTierValues.map((tier) => (
                      <button
                        type="button"
                        key={tier}
                        className={`gift-tier-btn ${giftTier === tier && !customAmount ? 'is-selected' : ''}`}
                        onClick={() => selectGiftTier(tier)}
                      >
                        ${tier}
                      </button>
                    ))}
                  </div>

                  <div className="gift-cards-custom">
                    <label htmlFor="gift-custom-amount">Or enter a custom amount</label>
                    <div className="gift-cards-amount-input">
                      <span>$</span>
                      <input
                        id="gift-custom-amount"
                        type="number"
                        min="1"
                        placeholder="75"
                        value={customAmount}
                        onChange={handleCustomAmount}
                      />
                    </div>
                  </div>

                  <div className="gift-cards-divider" aria-hidden="true"></div>

                  <div className="gift-cards-fields">
                    <input
                      type="text"
                      placeholder="Recipient name"
                      value={recipientName}
                      onChange={(e) => setRecipientName(e.target.value)}
                    />
                    <input
                      type="email"
                      placeholder="Your email"
                      required
                      value={recipientEmail}
                      onChange={(e) => setRecipientEmail(e.target.value)}
                    />
                    <textarea
                      placeholder="Personal message (optional)"
                      rows="3"
                      value={giftMessage}
                      onChange={(e) => setGiftMessage(e.target.value)}
                    />
                  </div>

                  <button type="submit" className="btn btn-primary gift-cards-submit" disabled={giftSubmitDisabled}>
                    <span>BUY {giftAmountDisplay} GIFT CARD</span>
                    {arrowRightSVG}
                  </button>
                </form>
              )}
            </div>
          </div>
        </section>
  )
}

/* ========================================
   Gift Cards Section
   ======================================== */

.gift-cards-layout {
  display: flex;
  gap: var(--space-16);
  flex-wrap: wrap;
  align-items: flex-start;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.gift-cards-info {
  flex: 1;
  min-width: 320px;
  text-align: left;
}

.gift-cards-info p {
  max-width: 440px;
}

.gift-card-visual {
  background: var(--primary);
  color: #f6efe6;
  padding: var(--space-8);
  max-width: 400px;
}

.gift-card-visual .gift-card-brand {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  color: #e8d9c5;
  margin-bottom: 6px;
}

.gift-card-visual .gift-card-label {
  font-size: 1.125rem;
  margin-bottom: var(--space-4);
}

.gift-card-visual .gift-card-sub {
  font-size: 0.8125rem;
  color: #c9b998;
}

.gift-card-visual .gift-card-amount {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  color: var(--primary-foreground);
  margin-top: var(--space-4);
}

.gift-cards-form {
  flex: 1;
  min-width: 320px;
  background: var(--card);
  border: 1px solid var(--border);
  padding: var(--space-8);
}

.gift-cards-form-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--primary);
  margin-bottom: var(--space-3);
}

.gift-tier-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(64px, 1fr));
  gap: 10px;
  margin-bottom: var(--space-4);
}

.gift-tier-btn {
  padding: 14px 0;
  font-size: 0.875rem;
  font-weight: 700;
  border: 1.5px solid var(--input-border);
  background: var(--background);
  color: var(--primary);
  cursor: pointer;
  transition: border-color 0.2s ease;
}

.gift-tier-btn:hover {
  border-color: var(--accent-hover);
}

.gift-tier-btn.is-selected {
  border-color: var(--accent);
  color: var(--accent);
}

.gift-cards-custom {
  margin-bottom: var(--space-6);
}

.gift-cards-custom label {
  display: block;
  font-size: 0.75rem;
  color: var(--muted-foreground);
  margin-bottom: 6px;
}

.gift-cards-amount-input {
  display: flex;
  align-items: center;
  border: 1.5px solid var(--input-border);
  background: var(--background);
}

.gift-cards-amount-input span {
  padding: 0 12px;
  color: var(--muted-foreground);
}

.gift-cards-amount-input input {
  border: none;
  outline: none;
  padding: 12px 12px 12px 0;
  font-size: 0.875rem;
  width: 100%;
  background: transparent;
  font-family: var(--font-sans);
}

.gift-cards-divider {
  height: 1px;
  background: var(--border);
  margin: var(--space-6) 0;
}

.gift-cards-fields {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.gift-cards-fields input,
.gift-cards-fields textarea {
  border: 1.5px solid var(--input-border);
  padding: 12px 14px;
  font-size: 0.875rem;
  outline: none;
  font-family: var(--font-sans);
  background: var(--background);
  resize: vertical;
}

.gift-cards-submit {
  width: 100%;
  justify-content: center;
  margin-top: var(--space-6);
}

.gift-cards-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.gift-cards-submit:disabled:hover {
  transform: none;
}

.gift-cards-success {
  text-align: center;
  padding: var(--space-10) var(--space-2);
}

.gift-cards-success-icon {
  font-size: 2rem;
  color: var(--success);
  margin-bottom: var(--space-3);
}

.gift-cards-success h4 {
  margin-bottom: var(--space-2);
}

.gift-cards-success p {
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.gift-cards-restart {
  display: inline-block;
  margin-top: var(--space-4);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent);
}

.gift-cards-restart:hover {
  color: var(--accent-hover);
}